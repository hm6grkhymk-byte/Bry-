<section class="section">
  <div class="container">
    <h1 class="page-heading">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="fan-club-form__row search-form">
      <label class="visually-hidden" for="SearchInput">{{ 'search.label' | t }}</label>
      <input id="SearchInput" class="field" type="search" name="q" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn--secondary">{{ 'search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <p class="caption-box search-count">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
          <ul class="comic-grid" role="list">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <li>{% render 'product-card', product: item, heading: 'h2' %}</li>
              {%- else -%}
                <li class="panel"><a class="product-card__info product-card__title" href="{{ item.url }}">{{ item.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="balloon">{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

<style>
  .search-form { margin-bottom: var(--space-5); max-width: 40rem; }
  .search-count { margin-bottom: var(--space-4); }
</style>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
