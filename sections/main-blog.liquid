<section class="section">
  <div class="container">
    <h1 class="page-heading">{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 12 -%}
      <ul class="comic-grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <article class="panel product-card-panel">
              <a href="{{ article.url }}" class="product-card">
                {%- if article.image -%}
                  <div class="product-card__media">
                    {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 450, 600, 800', sizes: '(min-width: 990px) 380px, 50vw', alt: article.image.alt | default: article.title }}
                  </div>
                {%- endif -%}
                <div class="product-card__info">
                  <h2 class="product-card__title">{{ article.title | escape }}</h2>
                  <p>{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                </div>
              </a>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
