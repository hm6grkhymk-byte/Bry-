<section class="section">
  <div class="container">
    <article class="panel page-panel">
      <p class="caption-box">{{ article.published_at | time_tag: format: 'date' }}</p>
      <h1>{{ article.title | escape }}</h1>
      {%- if article.image -%}
        {{ article.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 760px, 100vw', alt: article.image.alt | default: article.title }}
      {%- endif -%}
      <div class="rte">{{ article.content }}</div>
      <p><a href="{{ blog.url }}">{{ 'blogs.back' | t: title: blog.title }}</a></p>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
