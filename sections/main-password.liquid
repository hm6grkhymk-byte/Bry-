{%- comment -%}
  "Coming soon" page shown while the store is password protected.
  Visitors can join the fan club to hear when Issue #1 drops.
{%- endcomment -%}
<section class="section">
  <div class="container">
    <div class="panel page-panel password">
      <p class="password__logo">{% render 'logo', size: 'hero' %}</p>
      <p class="caption-box">{{ section.settings.kicker | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="balloon">{{ shop.password_message | escape }}</p>
      {%- endif -%}
      {% render 'fan-club-form', form_id: 'FanClubPassword', tags: 'newsletter, fan-club, prelaunch' %}

      <details class="password__enter">
        <summary class="link-button">{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password', class: 'fan-club-form__row password__form' -%}
          <label class="visually-hidden" for="PasswordInput">{{ 'password.password_label' | t }}</label>
          <input id="PasswordInput" class="field" type="password" name="password" autocomplete="current-password" required>
          <button type="submit" class="btn">{{ 'password.submit' | t }}</button>
          {%- if form.errors -%}
            <p class="form-error" role="alert">{{ form.errors.messages.form }}</p>
          {%- endif -%}
        {%- endform -%}
        <p class="password__owner">{{ 'password.owner' | t }} <a href="/admin">{{ 'password.login' | t }}</a></p>
      </details>
    </div>
  </div>
</section>

<style>
  .password { text-align: center; }
  .password .fan-club-form { max-width: 30rem; margin: var(--space-5) auto; }
  .password__logo { display: flex; justify-content: center; }
  .password__logo .logo--text { font-size: clamp(3rem, 14vw, 5.5rem); }
  .password__logo img.logo { max-width: 320px; }
  .password__enter { margin-top: var(--space-6); }
  .password__form { max-width: 30rem; margin: var(--space-4) auto; }
  .password__owner { font-size: 0.9rem; }
</style>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Label", "default": "Issue #1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming soon" }
  ]
}
{% endschema %}
