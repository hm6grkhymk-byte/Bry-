{%- comment -%}
  Basic list of all collections. Becomes "Pick your issue" in build step 3.
{%- endcomment -%}
<section class="section">
  <div class="container">
    <h1 class="page-heading">{{ section.settings.heading | escape }}</h1>
    <ul class="comic-grid" role="list">
      {%- for collection in collections -%}
        <li>
          <article class="panel product-card-panel">
            <a href="{{ collection.url }}" class="product-card">
              <div class="product-card__media">
                {%- if collection.featured_image -%}
                  {{
                    collection.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 800',
                      sizes: '(min-width: 990px) 380px, 50vw',
                      alt: collection.featured_image.alt | default: collection.title
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="product-card__info">
                <h2 class="product-card__title">{{ collection.title | escape }}</h2>
              </div>
            </a>
          </article>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your issue"
    }
  ]
}
{% endschema %}
