<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_yellow }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {{ 'dela-gothic-one-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'comic-neue-700.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% render 'meta-tags' %}
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Noviko = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }}
        },
        strings: {
          added: {{ 'cart.added' | t | json }},
          updated: {{ 'cart.updated' | t | json }},
          error: {{ 'cart.error' | t | json }},
          stashOne: {{ 'header.stash_label' | t: count: 1 | json }},
          stashOther: {{ 'header.stash_label' | t: count: 99999 | json }}
        },
        sfx: {{ settings.sfx_words | json }}
      };
    </script>
    <script src="{{ 'noviko.js' | asset_url }}" defer="defer"></script>

    {%- if request.page_type == 'index' -%}
      {% render 'site-schema' %}
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.halftone_background %} has-halftone{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="site-main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
  </body>
</html>
