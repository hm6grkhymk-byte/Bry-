{%- comment -%}
  Fonts and design tokens. Colors come from Theme settings > Colors so they
  can be changed in the Shopify admin without touching code.
{%- endcomment -%}
<style>
  @font-face {
    font-family: 'Dela Gothic One';
    font-weight: 400;
    font-style: normal;
    font-display: swap;
    src: url('{{ 'dela-gothic-one-400.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Comic Neue';
    font-weight: 400;
    font-style: normal;
    font-display: swap;
    src: url('{{ 'comic-neue-400.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Comic Neue';
    font-weight: 700;
    font-style: normal;
    font-display: swap;
    src: url('{{ 'comic-neue-700.woff2' | asset_url }}') format('woff2');
  }

  :root {
    --ink: {{ settings.color_ink }};
    --paper: {{ settings.color_paper }};
    --yellow: {{ settings.color_yellow }};
    --magenta: {{ settings.color_magenta }};
    --cyan: {{ settings.color_cyan }};
    --violet: {{ settings.color_violet }};
    --logo-width: {{ settings.logo_width }}px;
  }
</style>
