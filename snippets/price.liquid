{%- comment -%}
  Price display. Params: product (required), variant (optional, defaults to selected/first available).
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}{% unless target.available %} price--sold-out{% endunless %}" data-price>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
    <span class="price__current">{{ target.price | money }}</span>
    <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
    <s class="price__compare">{{ target.compare_at_price | money }}</s>
  {%- else -%}
    <span class="price__current">{{ target.price | money }}</span>
  {%- endif -%}
</div>
